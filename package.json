{
  "name": "nuxt-commerce-test",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "build:cf": "nuxt build --preset=cloudflare_pages",
    "check": "npm run lint && npm run typecheck",
    "deploy": "npm run build:cf && wrangler pages deploy dist --project-name=demo-commerc",
    "dev": "nuxt dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "postinstall": "nuxt prepare",
    "preview": "nuxt preview",
    "preview:cf": "wrangler pages dev dist",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.114",
    "@iconify-json/simple-icons": "^1.2.87",
    "@nuxt/image": "^2.0.0",
    "@nuxt/ui": "^4.9.0",
    "nuxt": "^4.4.8",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "eslint": "^10.6.0",
    "nitro-cloudflare-dev": "^0.2.2",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.5",
    "wrangler": "^4.114.0"
  },
  "packageManager": "npm@11.18.0"
}
